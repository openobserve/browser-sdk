 .../browser-core/test/coreConfiguration.ts    |  7 ++++
 packages/js-core/api/transport.api.md         |  2 ++
 .../js-core/src/transport/endpointBuilder.ts  | 20 ++++++-----
 4 files changed, 52 insertions(+), 10 deletions(-)

diff --git a/packages/browser-core/src/domain/configuration/configuration.ts b/packages/browser-core/src/domain/configuration/configuration.ts
