+    // width-guessing toPaddedHexadecimalString gets this one wrong.
+    const id = createTraceIdentifierFromHex('00000000000000001234567890abcdef')
+    expect(toPaddedTraceIdHex(id)).toEqual('00000000000000001234567890abcdef')
